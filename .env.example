# Optional local settings. Copy to .env in the repository root.
MODERATION_APP_NAME="Moderation API"
MODERATION_DOCS_ENABLED=true
MODERATION_DATABASE_PATH=data/local/moderation.db
MODERATION_SESSION_TTL_SECONDS=1800
MODERATION_LOGIN_MAX_ATTEMPTS=5
MODERATION_LOGIN_WINDOW_SECONDS=60
MODERATION_SCORER_MODE=simulated
# For a trusted locally trained sklearn pipeline only:
# MODERATION_SCORER_MODE=model
# MODERATION_MODEL_PATH=data/local/logistic_tfidf/logistic_tfidf.joblib
# MODERATION_MODEL_VERSION=tfidf-logistic-regression-v1

# Demo passwords are entered with hidden prompts using:
# python -m app.seed_demo_users
# Never put real passwords in this example file.
