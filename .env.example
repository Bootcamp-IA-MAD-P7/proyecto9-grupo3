# Optional local settings. Copy to .env in the repository root.
MODERATION_APP_NAME="Moderation API"
MODERATION_DOCS_ENABLED=true
MODERATION_DATABASE_PATH=data/local/moderation.db
MODERATION_SESSION_TTL_SECONDS=1800
MODERATION_LOGIN_MAX_ATTEMPTS=5
MODERATION_LOGIN_WINDOW_SECONDS=60

